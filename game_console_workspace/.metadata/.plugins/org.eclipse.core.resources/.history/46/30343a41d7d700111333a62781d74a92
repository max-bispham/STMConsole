#include "app.h"
#include "screen.h"
#include "drv_oled.h"
#include "drv_led.h"
#include "drv_keypad.h"
extern "C" {

void app_main(void) {

	drv_keypad.open();
	drv_led.open();
	uint8_t state = 0x00;
	while (1) {
		keypad_tick();
		dev_keypad.read(&state, sizeof(state));
		dev_led.write();
	}

}
}



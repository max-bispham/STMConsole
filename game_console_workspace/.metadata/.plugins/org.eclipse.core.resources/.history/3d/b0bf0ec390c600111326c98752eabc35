/* dev_display ioctl requests; arg points at one uint8_t */
#define DISPLAY_SET_CONTRAST  1   /* 0 to 255 */
#define DISPLAY_SET_POWER     2   /* 0 = panel off, 1 = on */
#define DISPLAY_SET_INVERT    3   /* 0 = normal, 1 = inverted */

#include "drv_led.h"
#include "main.h"

int led_open(void);
int close(void);
int close(void *buf, size_t len);
int write(const void *buf, size_t len);
int ioctrl;

const driver_t drv_led = {
		.open = led_open,
		.close = drv_nop,
		.read = drv_unsupported_read,
		.write = drv_unsupported_write,
		.ioctl = drv_unsupported_ioctl
};


static int led_open(void) {
	HAL_GPIO_WritePin(GPIOB, LED_GREEN_Pin, 0);
	HAL_GPIO_WritePin(GPIOB, LED_RED_Pin, 0);

	if (!green_err && !red_err) {
		return DRV_OK;
	} else {
		return -1;
	}
}
